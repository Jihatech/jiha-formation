# ── Plateforme jiha.tech — variables d'environnement ─────────────────────────
# Copier en .env.local et renseigner. Ne JAMAIS committer .env.local.

# URL publique du site (dev: http://localhost:3000 ; prod: https://learn.jiha.tech).
# Sous-domaine dédié : l'apex jiha.tech reste réservé au mail pro (MX intacts).
# Sert au canonical, aux hreflang, au metadataBase (OG) et aux redirections OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics Plausible (optionnel). Renseigner le domaine en prod pour activer
# le script (sans cookie, sans PII). Vide en dev/preview = aucun script injecté.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=learn.jiha.tech
# Self-hosting uniquement : URL du script (défaut : https://plausible.io/js/script.js).
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.example.com/js/script.js

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Supabase — clé service_role (SECRÈTE, serveur uniquement : suppression RGPD).
# Ne jamais préfixer NEXT_PUBLIC_ — ne doit jamais atteindre le navigateur.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Source du contenu (optionnel — défaut : repo JIHA-Learn main).
# JIHA_LEARN_RAW_BASE=https://raw.githubusercontent.com/Jihatech/JIHA-Learn/main

# ── Stripe (Vague 2 — Freemium) ──────────────────────────────────────────────
# Facturation de l'accès premium. Absent = pas de paywall actif (guides premium
# se comportent comme des guides connectés) et /premium affiche « bientôt ».
# Clé secrète serveur (SECRÈTE, jamais NEXT_PUBLIC_). Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
# Secret de signature du webhook. Créé avec l'endpoint /api/billing/webhook
# (Dashboard → Developers → Webhooks) ou affiché par `stripe listen` en local.
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de prix (Dashboard → Products) — un prix récurrent par cadence.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
